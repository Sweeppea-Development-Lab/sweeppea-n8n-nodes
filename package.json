{
	"name": "n8n-nodes-sweeppea",
	"version": "0.1.1",
	"description": "N8N community node for integrating Sweeppea sweepstakes platform with dynamic field support and AI chatbot integration",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"sweeppea",
		"sweepstakes",
		"giveaways",
		"contests",
		"chatbot",
		"ai-integration"
	],
	"license": "MIT",
	"homepage": "https://github.com/Sweeppea-Development-Lab/sweeppea-n8n-nodes#readme",
	"bugs": {
		"url": "https://github.com/Sweeppea-Development-Lab/sweeppea-n8n-nodes/issues"
	},
	"author": {
		"name": "Sweeppea Development Lab",
		"email": "support@sweeppea.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Sweeppea-Development-Lab/sweeppea-n8n-nodes.git"
	},
	"main": "index.js",
	"scripts": {
		"build": "node build.js",
		"dev": "tsc --watch",
		"format": "prettier nodes credentials --write",
		"lint": "eslint nodes credentials package.json",
		"lintfix": "eslint nodes credentials package.json --fix",
		"prepublishOnly": "npm run build && npm run lint"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/SweeppeaApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Sweeppea/Sweeppea.node.js"
		]
	},
	"devDependencies": {
		"@types/express": "^4.17.13",
		"@types/node": "^18.16.0",
		"@typescript-eslint/parser": "^5.30.0",
		"eslint": "^8.0.0",
		"eslint-plugin-n8n-nodes-base": "^1.11.0",
		"gulp": "^4.0.2",
		"n8n-workflow": "^1.0.0",
		"prettier": "^2.7.1",
		"typescript": "^4.9.0"
	}
}
