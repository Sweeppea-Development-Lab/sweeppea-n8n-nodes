{
	"name": "n8n-nodes-sweeppea",
	"version": "0.2.0",
	"description": "N8N community node for integrating Sweeppea sweepstakes platform with dynamic field support and AI chatbot integration",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"sweeppea",
		"sweepstakes",
		"giveaways",
		"contests",
		"chatbot",
		"ai-integration"
	],
	"license": "MIT",
	"homepage": "https://github.com/Sweeppea-Development-Lab/sweeppea-n8n-nodes#readme",
	"bugs": {
		"url": "https://github.com/Sweeppea-Development-Lab/sweeppea-n8n-nodes/issues"
	},
	"author": {
		"name": "Sweeppea Development Lab",
		"email": "support@sweeppea.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Sweeppea-Development-Lab/sweeppea-n8n-nodes.git"
	},
	"engines": {
		"node": ">=22.16"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"format": "prettier nodes credentials --write",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/SweeppeaApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Sweeppea/Sweeppea.node.js"
		]
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.0.1",
		"typescript": "5.9.3"
	}
}
