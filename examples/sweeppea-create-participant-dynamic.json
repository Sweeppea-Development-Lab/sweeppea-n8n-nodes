    {
      "parameters": {
        "jsCode": "/* Extract Schema Data */\nconst schemaData = $input.first().json;\n\nif (!schemaData.Response || !schemaData.FormFields) {\n\treturn { json: { error: 'Invalid schema response' } };\n}\n\n/* Helper Function: Convert Field Name To Slug */\nconst toSlug = (_name) => {\n\treturn _name.replace(/ /g, '_');\n};\n\n/* Build ALL Fields List (no separation between required/optional) */\nconst allFieldsList = schemaData.FormFields.map(f => {\n\n\tconst slug = toSlug(f.Name);\n\tlet fieldDescription = `- ${slug}`;\n\n\tif (f.Type === 'select' && f.Options) {\n\n\t\tconst options = f.Options.map(opt => opt.value).join(', ');\n\t\tfieldDescription += ` (Choose one: ${options})`;\n\t}\n\n\treturn fieldDescription;\n\n}).join('\\n');\n\n/* Build System Prompt */\nconst systemPrompt = `You are a friendly assistant helping users register for a sweepstake.\n\nAsk for ALL the following fields ONE at a time in a conversational way:\n\n${allFieldsList}\n\nWhen you have collected ALL the fields above, respond ONLY with a JSON object in this EXACT format:\n\n{\n  \"action\": \"create_participant\",\n  \"First_Name\": \"John\",\n  \"Last_Name\": \"Doe\",\n  \"Email\": \"user@example.com\",\n  \"Mobile_Number\": \"1234567890\"\n}\n\nImportant:\n- Be friendly and engaging\n- Validate email format (must contain @ and .)\n- Phone must be 10 digits\n- For select fields, only accept the listed options\n- When you have ALL the data, respond ONLY with the JSON (no additional text)`;\n\n/* Return System Prompt */\nreturn {\n\tjson: {\n\t\tsystemPrompt    : systemPrompt,\n\t\tformFields      : schemaData.FormFields,\n\t\tsweepstakesName : schemaData.SweepstakesName || 'Unknown'\n\t}\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        368,
        240
      ],
      "id": "3a4e8c5f-b2c4-4d1e-8e3f-a5c6d7e8f9a0",
      "name": "Build Dynamic Prompt"
    },
    {
      "parameters": {
        "jsCode": "/* Extract AI Output */\nlet aiOutput = $input.first().json.output;\n\n/* Clean Markdown */\naiOutput = aiOutput.replace(/```json\\s*/g, '').replace(/```/g, '').trim();\n\n/* Parse JSON */\nconst parsed = JSON.parse(aiOutput);\n\n/* Check Action */\nif (parsed.action !== 'create_participant') {\n\treturn { json: {} };\n}\n\n/* Remove Action */\nconst { action, ...fields } = parsed;\n\n/* Get Schema Fields */\nconst formFields = $('Build Dynamic Prompt').item.json.formFields;\n\n/* Build Fields Object Dynamically */\nconst apiFields = {};\nlet keyEmail = '';\nlet keyPhoneNumber = '';\n\nfor (const fieldConfig of formFields) {\n\n\tconst slug = fieldConfig.Name.replace(/ /g, '_');\n\tconst value = fields[slug] || '';\n\n\t/* Store Key Fields */\n\tif (fieldConfig.Name === 'Email') {\n\t\tkeyEmail = value;\n\t} else if (fieldConfig.Name === 'Mobile Number') {\n\t\tkeyPhoneNumber = value;\n\t}\n\n\t/* Add All Fields */\n\tapiFields[slug] = value;\n}\n\n/* Return API Format */\nreturn {\n\tjson: {\n\t\tKeyEmail       : keyEmail,\n\t\tKeyPhoneNumber : keyPhoneNumber,\n\t\tBonusEntries   : 0,\n\t\tFields         : apiFields\n\t}\n};"
      },
