		{
			"parameters": {
				"jsCode": "/* Extract AI Output */\nlet aiOutput = $input.first().json.output;\n\n/* Clean Markdown */\naiOutput = aiOutput.replace(/```json\\s*/g, '').replace(/```/g, '').trim();\n\n/* Parse JSON */\nconst parsed = JSON.parse(aiOutput);\n\n/* Check Action */\nif (parsed.action !== 'create_participant') {\n\treturn { json: {} };\n}\n\n/* Remove Action */\nconst { action, ...fields } = parsed;\n\n/* Return API Format */\nreturn {\n\tjson: {\n\t\tKeyEmail       : fields.Email || '',\n\t\tKeyPhoneNumber : fields.Mobile_Number || '',\n\t\tBonusEntries   : 0,\n\t\tFields         : {\n\t\t\tFirst_Name    : fields.First_Name || '',\n\t\t\tLast_Name     : fields.Last_Name || '',\n\t\t\tEmail         : fields.Email || '',\n\t\t\tMobile_Number : fields.Mobile_Number || ''\n\t\t}\n\t}\n};"
			},
